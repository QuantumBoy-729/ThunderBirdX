# NSIS defines for ThunderBirdX builds (personal fork).
# The release build branding.nsi is located in other-license/branding/thunderbird/

# BrandFullNameInternal is used for some registry and file system values
# instead of BrandFullName and typically should not be modified.
!define BrandFullNameInternal "ThunderBirdX"
!define BrandFullName         "ThunderBirdX"
!define CompanyName           "ThunderBirdX"
!define URLInfoAbout          "https://github.com/QuantumBoy-729/ThunderBirdX"
!define URLUpdateInfo         "https://github.com/QuantumBoy-729/ThunderBirdX/releases"
!define URLSystemRequirements "https://www.thunderbird.net/thunderbird/system-requirements/"
!define SurveyURL             ""
